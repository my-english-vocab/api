# Spring profile
# local: H2 사용
# postgres: 로컬 Docker PostgreSQL 사용
# prod: 운영 환경
SPRING_PROFILES_ACTIVE=local

# Docker Compose는 기본으로 postgres 프로필을 사용합니다.
# 실제 운영 설정 점검이 필요할 때만 prod로 변경합니다.
# COMPOSE_SPRING_PROFILE=prod

# JWT (운영에서는 최소 32자 이상인 긴 랜덤 문자열 필수)
JWT_SECRET=change-me-to-at-least-32-characters-long

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
# prod 프로필에서는 세 값 모두 필수
DB_URL=jdbc:postgresql://localhost:5432/myenglishvocab
DB_USERNAME=vocab_app
DB_PASSWORD=local-vocab-password

# CORS
# prod 프로필에서는 실제 프론트엔드 주소를 설정
# 여러 주소는 쉼표(,)로 구분
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI provider: openai | gemini
AI_PROVIDER=openai

# OpenAI 사용 시 필요
OPENAI_API_KEY=your-openai-api-key

# Gemini 사용 시 필요
GEMINI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
