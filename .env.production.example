# Browser-visible frontend origin
CORS_ALLOWED_ORIGINS=https://app.myenglishvocab.com

# Database (use a new long random value in the real .env.production file)
DB_USERNAME=vocab_app
DB_PASSWORD=replace-with-a-long-random-database-password

# JWT signing key: at least 32 random characters
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Choose exactly one provider and fill only that provider's key in the real file.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key

GEMINI_ENABLED=true
GEMINI_API_KEY=
